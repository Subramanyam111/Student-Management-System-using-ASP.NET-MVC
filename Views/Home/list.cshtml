@model IEnumerable<EntityAspMvcFirst.Models.Student>
@{
    var role = Context.Session.GetString("role");
    var isNormalUser = role == "user";

}

@{
    ViewData["Title"] = "Student List";
}

<style>
    body {
        background: #f9fafb;
        font-family: 'Poppins', sans-serif;
        overflow: hidden; 
    }

    .page-wrapper {
        padding: 30px;
        height: calc(100vh - 150px); /* ✅ Fits inside navbar + footer */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .card-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5e7eb;
        width: 100%;
        max-width: 1200px;
        height: 100%;
        display: flex;
        flex-direction: column; /* ✅ Enables fixed header + scroll body */
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 15px;
        flex-shrink: 0; /* ✅ Prevents collapsing during scroll */
    }

    .top-bar2 {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 15px;
        flex-shrink: 0;
        align-self:center;
    }

    .page-title {
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    
   .search-box{
        display: flex;
        gap: 10px;
    }

    

        .search-box input {
            width: 160px;
        }

    /* ✅ THIS IS THE SCROLL CONTAINER */
    .table-scroll {
        flex-grow: 1;
        overflow-y: auto;
        border-top: 1px solid #e5e7eb;
        margin-top: 10px;
    }

    .table thead {
        background: #eef2ff;
        color: #111827;
        position: sticky;
        top: 0;
        z-index: 5; /* ✅ Header stays visible while scrolling */
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .footer-empty {
        text-align: center;
        color: #6b7280;
        margin-top: 30px;
    }

    .popup {
        position: absolute;
        top: 90px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 999;
    }
</style>

<div class="page-wrapper">

    @* ✅ Alerts *@
    @if (TempData["message"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show w-25 text-center popup">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["insert"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show w-25 text-center popup">
            @TempData["insert"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card-box">

        <!-- ✅ FIXED TOP BAR -->
        <div class="@(!isNormalUser ? "top-bar" : "top-bar2")">
            @if (!isNormalUser)
            {
            <div class="d-flex gap-2">

                <a asp-action="Create" class="btn btn-success">+ Create Student</a>
            </div>
            }

            <form method="get" class="search-box">
                <input type="number" name="id" class="form-control" placeholder="Student ID" />
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="List" class="btn btn-outline-secondary">Reset</a>
            </form>

            
        </div>

        <!-- ✅ SCROLL-ONLY RECORD AREA -->
        @if (Model != null && Model.Any())
        {
            <div class="table-scroll">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Department</th>
                            <th>Admission</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StudentId</td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.Age</td>
                                <td>@item.Gender</td>
                                <td>@item.Department</td>
                                <td>@item.DateOfAdmission.ToShortDateString()</td>

                                <td class="action-buttons">
                                    @if (!isNormalUser)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-warning btn-sm">Edit</a>                    
                                    }
                                    <a asp-action="Details" asp-route-id="@item.StudentId" class="btn btn-info btn-sm text-white">View</a>
                                    @if (!isNormalUser)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.StudentId" class="btn btn-danger btn-sm text-white">Delete</a>                    
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="footer-empty">
                <h5>No records available.</h5>
            </div>
        }

    </div>
</div>
