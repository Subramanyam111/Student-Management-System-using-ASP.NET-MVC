@model EntityAspMvcFirst.Models.Student

@{
    ViewData["Title"] = "Student Profile";
    var role = Context.Session.GetString("role");
    var isNormalUser = role == "user";
}

<style>
    body {
        background: #f9fafb;
        font-family: 'Poppins', sans-serif;

    }

    .page-wrapper {
        
        display: flex;
        justify-content: center;
        align-items: center;
        
    }

    .profile-card {
        background: #ffffff;
        padding: 0;
        border-radius: 16px;
        
        width: 500px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #e5e7eb;
        overflow: hidden;
    }

  
    .name-card {
        background: #4f46e5;
        color: white;
        padding: 20px 30px;
        text-align: center;
    }

        .name-card h3 {
            margin: 0;
            font-weight: 700;
            font-size: 20px;
        }

        .name-card small {
            font-size: 13px;
            opacity: 0.9;
        }

    .profile-content {
        padding: 35px 40px;
    }

    .profile-title {
        font-size: 22px;
        font-weight: 700;
        color: #111827;
        text-align: center;
        margin-bottom: 20px;
    }

    .details-box {
        margin-bottom: 25px;
    }

    .details-row {
        display: flex;
        padding: 10px 0;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

        .details-row:last-child {
            border-bottom: none;
        }

    .details-label {
        width: 35%;
        font-weight: 600;
        color: #374151;
    }

    .details-value {
        width: 65%;
        color: #111827;
        font-weight: 500;
    }

    .profile-actions {
        margin-top: 20px;
        display: grid;
        gap: 10px;
    }

    .btn-edit {
        background: #4f46e5;
        color: white;
        font-weight: 600;
        padding: 12px;
        border-radius: 10px;
        width: 100%;
    }

        .btn-edit:hover {
            background: #4338ca;
            color: white;
        }

    .btn-back {
        width: 100%;
        font-weight: 600;
        border-radius: 10px;
    }
</style>
<div class="page-wrapper">
    <div class="profile-card">

        <!-- ✅ SIMPLE PROFILE NAME CARD -->
        <div class="name-card">
            <h3>@Model.FullName</h3>
            <small>@Model.Department</small>
        </div>

        <div class="profile-content">

            <div class="details-box">

                <div class="details-row">
                    <div class="details-label">Student ID</div>
                    <div class="details-value">@Model.StudentId</div>
                </div>

                <div class="details-row">
                    <div class="details-label">Email</div>
                    <div class="details-value">@Model.Email</div>
                </div>

                <div class="details-row">
                    <div class="details-label">Age</div>
                    <div class="details-value">@Model.Age</div>
                </div>

                <div class="details-row">
                    <div class="details-label">Gender</div>
                    <div class="details-value">@Model.Gender</div>
                </div>

                <div class="details-row">
                    <div class="details-label">Department</div>
                    <div class="details-value">@Model.Department</div>
                </div>

                <div class="details-row">
                    <div class="details-label">Admission Date</div>
                    <div class="details-value">@Model.DateOfAdmission.ToShortDateString()</div>
                </div>

            </div>

            <!-- ✅ ACTIONS -->
            <div class="profile-actions">
                @if (role == "admin")
                {
                    <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-edit">
                        Edit Student
                    </a>
                }
                <a asp-action="List" class="btn btn-outline-secondary btn-back">
                    Back to List
                </a>
            </div>

        </div>

    </div>
</div>
