@{
    var profileName = Context.Session.GetString("username");

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Management System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            background-image: url('/images/bgfile3.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        .content {
            min-height: calc(100vh - 120px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding-top: 80px;
            padding-bottom: 60px;
        }

        .app-navbar {
            backdrop-filter: blur(12px);
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .app-name {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #0f172a; /* Deep slate */
            margin: 0;
            display: flex;
            align-items: center;
        }

            .app-name span {
                color: #2563eb; /* Premium blue */
                margin-left: 4px;
            }


        .user-dropdown {
            font-weight: 600;
        }

        .app-footer {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border-top: 1px solid #e5e7eb;
            text-align: center;
            padding: 12px 0;
            font-size: 13px;
            color: #6b7280;
            position: fixed;
            width: 100%;
            bottom: 0;
        }
    </style>
</head>

<body>

    <!-- ✅ NAVBAR START -->
    <nav class="navbar navbar-expand-lg fixed-top app-navbar px-4">
        <div class="container-fluid">

            <!-- ✅ Top Left: Application Name -->
            <h1 class="app-name">
                Student<span>Hub</span>
            </h1>


            <!-- ✅ Top Right: Admin Button + Logout -->
            <div class="d-flex align-items-center gap-3 ms-auto">

                <a class="btn btn-outline-primary fw-semibold"
                   asp-controller="Login"
                   asp-action="LoginUser">
                    🧑🏻‍💼 User
                </a>

                <!-- ✅ Admin Button -->
                <a class="btn btn-outline-primary fw-semibold"
                   asp-controller="Admin"
                   asp-action="AdminLogin">
                    🛡️ Admin
                </a>             

            </div>

        </div>
    </nav>
    <!-- ✅ NAVBAR END -->
    <!-- ✅ MAIN CONTENT -->
    <div class="container-fluid content">
        <main role="main" class="pb-3 w-100 d-flex justify-content-center">
            @RenderBody()
        </main>
    </div>

    <!-- ✅ FOOTER START -->
    <footer class="app-footer">
        © @DateTime.Now.Year - Student Management System | Built with ASP.NET Core MVC 🚀
    </footer>
    <!-- ✅ FOOTER END -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
